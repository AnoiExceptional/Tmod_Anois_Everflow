		Dynamic: {
			CurrentStage: Current awakening stage: {0}/8
			CurrentUnlocks: Unlocked abilities: {0}
			FullyAwakened: The dragon's will is fully awakened
			BladeWave: blade wave
			Wyvern: Phantom Wyvern (every 7 whip hits)
			StardustDragon: Phantom Stardust Dragon (every 5 whip hits)
			PhantasmDragon: Phantom Phantasm Dragon (every 3 whip hits)
			NoneUnlocked: None
			ListSeparator: ", "
			NextFirstBoss: Defeat any first boss to improve damage and attack speed
			NextSkeletron: Defeat Skeletron to improve damage and unlock the blade wave
			NextWallOfFlesh: Defeat the Wall of Flesh to improve combat performance and unlock the Phantom Wyvern
			NextMechBoss: Defeat any mechanical boss to improve damage and whip range
			NextPlantera: Defeat Plantera to improve damage and whip range
			NextCultist: Defeat the Lunatic Cultist to improve attack speed and unlock the Phantom Stardust Dragon
			NextMoonLord: Defeat the Moon Lord to fully awaken the dragon's will and unlock the Phantom Phantasm Dragon
			Flavor: Unsheathe the sword and awakening the dragons
		}
	}

