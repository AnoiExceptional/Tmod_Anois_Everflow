	AquaVirtue: {
		DisplayName: Aqua Virtue
		Tooltip:
			'''
			25% increased magic damage and critical strike chance
			100% increased mana cost and +100 maximum mana
			Halves mana regeneration delay and improves mana regeneration
			Automatically uses mana potions when needed without causing Mana Sickness
			Restores life equal to 20% of mana consumed
			Restores mana equal to 20% of damage taken
			Greatly increases mana star pickup range and pickup priority
			Taking damage causes three stars to fall and become mana stars on impact
			Increasing mana gains Aestus Dies, decreasing mana gains Aestus Nox
			'''
	}

